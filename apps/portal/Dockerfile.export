# syntax=docker/dockerfile:1
# Static export (out/) for S3 + CloudFront, built inside a pinned node image so CI needs no local node.
# Build context: repo root  ->
#   docker build -f apps/portal/Dockerfile.export \
#     --secret id=node_auth_token,env=NODE_AUTH_TOKEN \
#     --build-arg NEXT_PUBLIC_API_URL= \
#     --output type=local,dest=apps/portal/out .

ARG NODE_VERSION=22.22.2
ARG ALPINE_VERSION=3.22

# ---------- Stage 1: prune monorepo to this app + its workspace deps ----------
FROM node:${NODE_VERSION}-alpine${ALPINE_VERSION} AS pruner
WORKDIR /app
RUN npm install -g turbo@2.9.6
COPY . .
RUN turbo prune portal --docker

# ---------- Stage 2: install + next build (static export) ----------
FROM node:${NODE_VERSION}-alpine${ALPINE_VERSION} AS builder
WORKDIR /app
RUN corepack enable
ENV PNPM_HOME=/pnpm CI=true NEXT_TELEMETRY_DISABLED=1

COPY .npmrc ./
COPY --from=pruner /app/out/json/ ./
# @apisit110/pos-ui lives on GitHub Packages -> token comes in as a build secret
RUN --mount=type=cache,id=pnpm,target=/pnpm/store \
    --mount=type=secret,id=node_auth_token \
    NODE_AUTH_TOKEN="$(cat /run/secrets/node_auth_token 2>/dev/null || true)" \
    pnpm install --frozen-lockfile --store-dir /pnpm/store

COPY --from=pruner /app/out/full/ ./
# empty = call the api on the same origin (CloudFront routes /api/* to Lambda)
ARG NEXT_PUBLIC_API_URL=
ENV NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL} NEXT_OUTPUT=export
RUN pnpm turbo run export --filter=portal

# ---------- Stage 3: only the static files, copied out by --output ----------
FROM scratch AS export
COPY --from=builder /app/apps/portal/out/ /
